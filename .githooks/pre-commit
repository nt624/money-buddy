#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# Detect which directories have staged changes
STAGED_FILES=$(git diff --cached --name-only)

run_backend=false
run_frontend=false

if echo "$STAGED_FILES" | grep -q "^backend/"; then
  run_backend=true
fi
# Frontend now lives under apps/* and packages/* (npm workspaces + Turborepo)
if echo "$STAGED_FILES" | grep -qE "^(apps/|packages/)"; then
  run_frontend=true
fi

# --- Backend checks ---
if [ "$run_backend" = true ]; then
  echo "[pre-commit] Running backend checks..."
  cd "$ROOT/backend"

  echo "  go build ./..."
  go build ./...

  echo "  go vet ./..."
  go vet ./...

  echo "[pre-commit] Backend checks passed."
  cd "$ROOT"
fi

# --- Frontend checks (workspaces via Turborepo) ---
if [ "$run_frontend" = true ]; then
  echo "[pre-commit] Running frontend checks..."
  cd "$ROOT"

  echo "  turbo run lint typecheck"
  npx turbo run lint typecheck

  echo "[pre-commit] Frontend checks passed."
fi

echo "[pre-commit] All checks passed."
